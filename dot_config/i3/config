# i3 config — managed by chezmoi (dot_config/i3/config in the dotfiles source). Edit the
# source and run `chezmoi apply` (which restarts i3); do not edit ~/.config/i3/config.

# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles. There is no i3bar: tauler draws the bar.
font pango:MonaspiceXe Nerd Font Mono 16px

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet
exec --no-startup-id /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
exec --no-startup-id ~/.cargo/bin/tauler
# Dictation daemon. Started via the script so the capture-device pin lives in one place.
exec --no-startup-id bash $HOME/.config/i3/voxtype_daemon.sh start

# Pre-load the knob-click sample into PulseAudio's sample cache once at
# startup — `pactl play-sample` then triggers it with ~5ms latency (vs ~390ms
# for `paplay` decoding the file fresh each time), since it's just a message
# to the already-running daemon rather than a new process+connection+decode.
# The sample is pre-attenuated to 30% rather than turned down at playback:
# `pactl play-sample` takes only NAME and SINK, no volume, and switching to a
# player that accepts one would give back the latency this design exists for.
# Derived from kenney_ui-audio/Audio/switch16.ogg with `ffmpeg -af volume=0.2`.
exec --no-startup-id pactl upload-sample $HOME/.config/i3/sounds/workspace-switch-click.ogg workspace-switch-click

# Use pactl to adjust volume in PulseAudio.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Take screenshots
bindsym --release $mod+Print exec scrot -e 'mv $f ~/Pictures/Screenshots'
bindsym --release $mod+Shift+Print exec scrot -s -e 'mv $f ~/Pictures/Screenshots'
bindsym $mod+Shift+s exec --no-startup-id ~/.config/i3/screenshot-region.sh

# Copy the path of a recently edited / downloaded file via rofi.
bindsym $mod+y exec --no-startup-id ~/.config/i3/rofi_recent_files.sh

bindsym $mod+u fullscreen toggle



# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
# Try the enwiro-aware terminal first (kitty template: host kitty wrapping the
# active env's shell, containerized when an image exists); fall back to the
# generic launcher if kitty isn't available.
bindsym $mod+Return exec ~/.cargo/bin/enw wrap kitty -- -1 || i3-sensible-terminal

# kill focused window
bindsym $mod+Shift+q kill

bindsym $mod+d [urgent=latest] focus


# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Go to previous workspace
bindsym $mod+o workspace back_and_forth
# Knob 3. Direction matches the brightness knobs in the mode blocks below.
# Via a script rather than prev/next_on_output, which wrap around.
bindsym $mod+i exec --no-startup-id bash $HOME/.config/i3/workspace_step.sh prev
bindsym $mod+Shift+i exec --no-startup-id bash $HOME/.config/i3/workspace_step.sh next

# Open applications
bindsym $mod+Escape exec ~/.cargo/bin/enw wrap rofi -- -show combi -matching fuzzy
bindsym Mod1+space exec ~/.cargo/bin/enw wrap rofi -- -show combi -matching fuzzy
bindsym Mod5+space exec ~/.cargo/bin/enw wrap rofi -- -show combi -matching fuzzy
bindsym Control+space exec ~/.cargo/bin/enw wrap rofi -- -show combi -matching fuzzy
bindsym Control+Escape exec "$HOME/.cargo/bin/wmfocus --halign center --valign center --font 'Mono:128' --textcolor red"
bindsym $mod+Shift+Escape exec rofi -show enwiro -modi "enwiro:$HOME/.cargo/bin/enwiro-bridge-rofi" -matching fuzzy -no-sort



# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+semicolon split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Screen brightness (ddcutil)
mode "brightness" {
        bindsym a exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 10
        bindsym s exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 20
        bindsym d exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 30
        bindsym f exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 40
        bindsym g exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 50
        bindsym h exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 60
        bindsym j exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 70
        bindsym k exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 80
        bindsym l exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 90
        bindsym semicolon exec --no-startup-id bash $HOME/.config/i3/set_brightness.sh 100
        # Knob 3 steps relative; the row above stays for absolute jumps.
        bindsym $mod+i exec --no-startup-id bash $HOME/.config/i3/screen_brightness_step.sh down
        bindsym $mod+Shift+i exec --no-startup-id bash $HOME/.config/i3/screen_brightness_step.sh up
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+b mode "default"
        # Next step of the cycle: back out to wherever it started.
        bindcode 199 exec --no-startup-id bash $HOME/.config/i3/mode_cycle.sh
}
bindsym $mod+b mode "brightness"

# Macropad F21 — see the note on keycode 200 below. Cycles:
#   here → screen brightness → back here
bindcode 199 exec --no-startup-id bash $HOME/.config/i3/mode_cycle.sh

# --- Recording mode ---
mode "recording" {
    bindsym $mod+Shift+v exec --no-startup-id ~/.config/i3/record-stop.sh
}
# Enter recording mode + start capture (same key toggles on/off)
bindsym $mod+Shift+v exec --no-startup-id ~/.config/i3/record-start.sh

# --- Dictation mode (voxtype voice-to-text) ---
# mod+grave: start recording; same key / Return / Escape: stop and type
# Media playing at entry is paused and resumed on exit — see
# dictation_media.sh for why it can't just be `playerctl play-pause`.
# Gated on the mode rather than on voice activity: mic VAD would flip-flop the
# music back on during every pause between sentences.
mode "dictating" {
    bindsym $mod+grave  exec --no-startup-id voxtype record stop, exec --no-startup-id ~/.config/i3/dictation_media.sh resume, mode "default"
    bindsym grave       exec --no-startup-id voxtype record stop, exec --no-startup-id ~/.config/i3/dictation_media.sh resume, mode "default"
    bindsym Return      exec --no-startup-id voxtype record stop, exec --no-startup-id ~/.config/i3/dictation_media.sh resume, mode "default"
    bindsym Escape      exec --no-startup-id voxtype record cancel, exec --no-startup-id ~/.config/i3/dictation_media.sh resume, mode "default"
}
bindsym $mod+grave exec --no-startup-id voxtype record start, exec --no-startup-id ~/.config/i3/dictation_media.sh pause, mode "dictating"

for_window [all] border pixel 1
for_window [all] title_window_icon yes
for_window [all] title_window_icon padding 1px
# gaps owned by tauler's <I3Layout>: the space its panels claim becomes the i3 gaps.
smart_borders on




bindsym $mod+M exec --no-startup-id ~/.config/i3/move_workspace_to_output.sh


# Scratchpad apps
for_window [class="^i3scratchpad$"] move scratchpad, sticky enable
exec --no-startup-id kitty -1 --class=i3scratchpad
exec --no-startup-id kitty -1 --class=i3scratchpad --directory ~/.local/share/chezmoi claude
bindsym $mod+n scratchpad show

# Zotero citation window
for_window [title="^Quick Format Citation$"] floating enable, sticky enable


bindsym --release $mod+Next exec --no-startup-id ~/.config/i3/radio_control.sh next
bindsym --release $mod+Prior exec --no-startup-id ~/.config/i3/radio_control.sh prev
bindsym --release $mod+End exec --no-startup-id mpc stop
bindsym --release $mod+Home exec --no-startup-id mpc toggle

# Hide trackball cursor after inactivity (seconds)
exec --no-startup-id unclutter --timeout 0.5


# tauler-theme.conf is GENERATED by tauler's <I3Theme /> unit (see
# ~/.config/tauler layout); edit the tauler layout, not the generated file.
include ~/.config/i3/tauler-theme.conf

title_align center

# TWP visual test: float Kitty windows so they don't disrupt tiling
for_window [class="^twp-visual-test"] floating enable

# Floating editor for qutebrowser
for_window [class="^KittyFloatingNeovim$" instance="^KittyFloatingNeovim$"] floating enable, sticky enable

# PiP gets a dedicated screen: DP-3 (the small landscape display next to the 4K).
workspace . output DP-3

# Automatically move Picture in Picture windows to workspace '.'
for_window [title="Picture in picture"] move to workspace .

# Force fullscreen mode for the PiP window
for_window [title="Picture in picture"] fullscreen enable

# Quickly switch to the PiP workspace
bindsym $mod+period workspace .
