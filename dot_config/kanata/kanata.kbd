;; kanata configuration
;; ----------------------
;; Caps Lock -> Escape, plus home row mods: d / k held -> super, f / j -> shift,
;; g / h -> ctrl,
;; space held -> home row becomes numbers (a s d f g h j k l ; -> 1..0),
;; Linux-style Ctrl (common ctrl shortcuts sent as their cmd versions),
;; and the cmd keys next to space as enter (left) / backspace (right).
;;
;; `process-unmapped-keys yes` makes kanata handle the whole keyboard (required
;; for home row mods). Keys not remapped below are passed through as-is.
;;
;; `tap-hold-require-prior-idle`: if another key was pressed less than this
;; many ms before a home row key, it is always a plain tap. Prevents accidental
;; modifiers while typing fast.

(defcfg
  process-unmapped-keys yes
  tap-hold-require-prior-idle 150
  concurrent-tap-hold yes
  chords-v2-min-idle 150
)

;; Which hand types each key. A home row mod only becomes its modifier when the
;; next key is on the opposite hand, e.g. hold f + press k -> K, but a quick
;; f-d roll stays "fd".
(defhands
  (left  grv 1 2 3 4 5 tab q w e r t a s d f g z x c v b)
  (right 6 7 8 9 0 - = y u i o p [ ] \ h j k l ; ' n m , . /))

;; macOS has no Super key, so "super" is ctrl+alt+cmd, which no app uses.
;; AeroSpace binds its i3-style shortcuts to it.
(defalias
  super (multi lctl lalt lmet)
)

;; Home row mod: tap -> $tap, hold -> $mod.
;; `-release`: an opposite-hand key only makes it a hold once that key is
;; pressed *and released* while this one is still down. Fast rolls ("do": d
;; up before o comes up) stay plain letters instead of firing super+o.
;; 200: ms before a held key counts as a hold even without another key press,
;; so shift + click or a slow deliberate hold still works.
;; `same-hand ignore`: a same-hand key doesn't decide tap vs hold, so mods on
;; one hand stack (hold d + f, then press h -> super+shift+h).
(deftemplate hrm (tap mod)
  (tap-hold-opposite-hand-release 200 $tap $mod (timeout hold) (same-hand ignore))
)

;; The same mods on the base layer and on the numbers layer.
(defalias
  d (t! hrm d @super)
  f (t! hrm f lsft)
  j (t! hrm j rsft)
  k (t! hrm k @super)
  3 (t! hrm 3 @super)
  4 (t! hrm 4 lsft)
  7 (t! hrm 7 rsft)
  8 (t! hrm 8 @super)
)

;; Space: tap -> space, hold -> numbers layer. `tap-hold-release` only picks
;; hold once another key is pressed *and released* while space is down, so
;; fast typing (space already released before the next key comes up) stays a
;; space. First 200: tap then hold within it repeats space.
(defalias
  spc (tap-hold-release 200 200 spc (layer-while-held numbers))
)

;; Linux-style Ctrl. Holding Ctrl keeps real ctrl down (so ctrl+r, ctrl+d,
;; ctrl+tab... work as usual) and switches to the linux-ctrl layer, where the
;; common app shortcuts are sent as their macOS versions instead:
;;   ctrl+<key>           -> cmd+<key>    (copy, paste, new tab, find, ...)
;;   ctrl+shift+<key>     -> unchanged    (kitty's ctrl+shift+c/v copy/paste)
;;   ctrl+shift+t / n / z -> cmd+shift    (reopen tab, private window, redo)
;;   ctrl+left / right    -> alt+arrow    (move by word)
;;   ctrl+bspc / del      -> alt+bspc/del (delete by word)
;;   ctrl+space           -> cmd+space    (Spotlight, like the Linux launcher)
;; kitty turns the cmd+<key> ones back into terminal ctrl
;; (~/.config/kitty/macos.conf).
(defalias
  lctl (multi lctl (layer-while-held linux-ctrl))
)

;; g / h held -> the same Linux-style Ctrl (home row mods, like d f j k).
(defalias
  g (t! hrm g @lctl)
  h (t! hrm h @lctl)
  5 (t! hrm 5 @lctl)
  6 (t! hrm 6 @lctl)
)

(deftemplate cmd (key)
  (fork (unmod (lctl) lmet $key) $key (lsft rsft))
)
(deftemplate cmd-shift-too (key)
  (unmod (lctl) lmet $key)
)
(deftemplate alt (key)
  (unmod (lctl) lalt $key)
)

(defalias
  c-a (t! cmd a)  c-c (t! cmd c)  c-f (t! cmd f)  c-l (t! cmd l)
  c-o (t! cmd o)  c-p (t! cmd p)  c-q (t! cmd q)  c-r (t! cmd r)
  c-s (t! cmd s)  c-v (t! cmd v)  c-w (t! cmd w)  c-x (t! cmd x)
  c-n (t! cmd-shift-too n)  c-t (t! cmd-shift-too t)  c-z (t! cmd-shift-too z)
  c-left (t! alt left)  c-right (t! alt right)
  c-bspc (t! alt bspc)  c-del (t! alt del)
  c-spc (t! cmd-shift-too spc)
)

;; Physical keys kanata watches.
(defsrc
  q    w e r t y u i o p
  caps a s d f g h j k l ;
  z    x c v b n m
  lctl lmet spc rmet bspc del left right
)

;; What they become. Position matches defsrc above.
;; Left cmd -> enter, right cmd -> backspace (thumb keys next to space).
(deflayer base
  q    w e r t y u i o p
  esc  a s @d @f @g @h @j @k l ;
  z    x c v b n m
  @lctl ret @spc bspc bspc del left right
)

;; While space is held. `_` = same as base.
(deflayer numbers
  _    _ _ _ _ _ _ _ _ _
  _    1 2 @3 @4 @5 @6 @7 @8 9 0
  _    _ _ _ _ _ _
  _    _ _ _ _ _ _ _
)

;; While ctrl is held.
(deflayer linux-ctrl
  @c-q @c-w _ @c-r @c-t _ _ _ @c-o @c-p
  _    @c-a @c-s _ @c-f _ _ _ _ @c-l _
  @c-z @c-x @c-c @c-v _ @c-n _
  _    _ @c-spc @c-bspc @c-bspc @c-del @c-left @c-right
)

;; j + k + l pressed together (within 40 ms) -> d is tab while they are held.
(defchordsv2
  (j k l) (layer-while-held jkl) 40 all-released ()
)

(deflayer jkl
  _    _ _ _ _ _ _ _ _ _
  _    _ _ tab _ _ _ _ _ _ _
  _    _ _ _ _ _ _
  _    _ _ _ _ _ _ _
)
