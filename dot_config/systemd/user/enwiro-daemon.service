[Unit]
Description=Enwiro workspace environment daemon
After=default.target

[Service]
# No GH_TOKEN: the gh processes the daemon spawns read the keyring themselves.
ExecStart=%h/.cargo/bin/enwiro-daemon
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/var/lib/snapd/snap/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
