[Unit]
Description=Enwiro workspace environment daemon
After=default.target

[Service]
ExecStart=%h/.cargo/bin/enwiro-daemon
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/var/lib/snapd/snap/bin
# Optional (the `-`): credentials such as GH_TOKEN, supplied per machine.
EnvironmentFile=-%h/.config/enwiro/env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
