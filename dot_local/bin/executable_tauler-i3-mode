#!/usr/bin/env bash
# Streams the active i3 binding mode as JSON lines for the tauler sidebar:
#   {"mode":"default"}
#   {"mode":"light-brightness"}
#
# i3 has no "what mode am I in" query, so "default" is assumed on every
# (re)connect. That is always true right after an i3 restart, and any later
# mode change corrects it.

while true; do
  echo '{"mode":"default"}'
  i3-msg -t subscribe -m '["mode"]' 2>/dev/null \
    | jq --unbuffered -c '{mode: .change}'
  sleep 1
done
